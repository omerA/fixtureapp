# Copy to .env and fill in values before running.

# Session signing key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://<your-domain>/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Contact address embedded in the scraper's User-Agent (NCSA bot identification)
SCRAPER_CONTACT=your-email@example.com
